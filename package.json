{
  "name": "sakagura-sumirator",
  "version": "1.0.0",
  "private": true,
  "description": "杜氏の役割を体験できる酒蔵シミュレーター（CloudFront + Lambda + DynamoDB / cdkd でデプロイ）",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "dev": "node scripts/build-web.mjs --serve",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "synth": "npm run build:web && cdkd synth",
    "diff": "npm run build:web && cdkd diff",
    "deploy": "npm run build:web && cdkd deploy",
    "deploy:fast": "npm run build:web && cdkd deploy --no-wait",
    "destroy": "cdkd destroy",
    "cdk:synth": "npm run build:web && cdk synth"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1163.0",
    "@aws-sdk/lib-dynamodb": "^3.1163.0",
    "@cdkd/cli": "^0.330.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1148.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
